{
    "name": "portfolio/amazon-deal-notifier",
    "description": "Amazon（PA-API 5.0）の割引商品を収集・分析し、Slackへ重複なく通知するツール",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "google/apiclient": "^2.18",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "DealRadar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DealRadar\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup",
        "test": "phpunit"
    },
    "extra": {
        "google/apiclient-services": [
            "Sheets"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
