# ===== データ取得 =====
# mock  : PA-API 5.0 互換のデモサーバー（認証情報なしで動作。署名は AWS 公式テストスイートの例示キーで行う）
# paapi : 本物の PA-API 5.0 に接続（アソシエイトの売上実績が必要）
DATA_SOURCE=mock

# PA-API 5.0（DATA_SOURCE=paapi のとき必須）
PAAPI_ACCESS_KEY=
PAAPI_SECRET_KEY=
PAAPI_PARTNER_TAG=
PAAPI_HOST=webservices.amazon.co.jp
PAAPI_REGION=us-west-2
PAAPI_MARKETPLACE=www.amazon.co.jp

# デモサーバーの挙動（任意）
#   MOCK_PRICE_SEED     : 価格変動の種。未設定なら1時間ごとに価格が変わる
#   MOCK_SIMULATE_ERROR : throttle＝初回だけ TooManyRequests（再試行の確認）/ SearchIndex 名＝そのカテゴリーで失敗
MOCK_PRICE_SEED=
MOCK_SIMULATE_ERROR=

# ===== 保存先 =====
# local  : storage/data/*.json（設定不要）
# sheets : Google スプレッドシート（Sheets API。GAS は使わない）
STORAGE=local
SPREADSHEET_ID=
# サービスアカウントの鍵ファイル（プロジェクトからの相対パス可）。GitHub Actions では GOOGLE_SERVICE_ACCOUNT_JSON を使う
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# ===== 通知 =====
# 未設定ならSlackへは送らず、storage/slack にプレビューだけ保存（ダッシュボードで確認可）
SLACK_WEBHOOK_URL=
# エラー通知の送り先（未設定なら SLACK_WEBHOOK_URL と同じ）
SLACK_ERROR_WEBHOOK_URL=

# ===== その他 =====
APP_TIMEZONE=Asia/Tokyo
# ダッシュボードのポート（既存の 8080 などと衝突しないように）
DASHBOARD_PORT=8094
# ダッシュボードの「今すぐ取得」ボタン（on で表示。最短間隔は基本設定の「手動取得の最短間隔（分）」）
MANUAL_FETCH=off
# ダッシュボードのBasic認証（両方設定したときだけ有効）
DASHBOARD_USER=
DASHBOARD_PASSWORD=
